# Camera stream configuration
# Can be MJPEG stream URL (e.g. http://192.168.1.150:81/stream), local video path, or "synthetic"
CAMERA_SOURCE=synthetic
CAMERA_ID=ESP32-CAM-01-NORTH
CAMERA_FPS=15
FRAME_WIDTH=400
FRAME_HEIGHT=300
RECONNECT_INTERVAL_SEC=2.0
MAX_RECONNECT_ATTEMPTS=10

# Backend ingestion API
BACKEND_API_URL=http://localhost:3000
ESP32_DEVICE_KEY=dev-presence-device-key-32
REQUEST_TIMEOUT_SEC=5.0

# Virtual boundary tripwire zones
ZONE_A=CORRIDOR_TRANSIT
ZONE_B=WORKSPACE_FLOOR
BOUNDARY_Y_RATIO=0.5

# Recognition and detection thresholds
COSINE_THRESHOLD=0.70
FACE_MIN_CONFIDENCE=0.50
PERSON_MIN_CONFIDENCE=0.45
DEBOUNCE_SECONDS=3.0

# DPDP Act 2023 volatile memory scrubbing
MEMORY_SCRUB_ENABLED=true

# Gateway server binding
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001

